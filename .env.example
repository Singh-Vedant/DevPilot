# DevPilot Environment Configuration

# 1. Database (managed by docker-compose)
DB_URL=jdbc:postgresql://localhost:5433/devpilot
DB_USERNAME=postgres
DB_PASSWORD=postgres

# 2. OpenAI API Key (Required for Code Embeddings and RAG Chat)
# Replace with your actual active OpenAI API key
OPENAI_API_KEY=your_openai_api_key_here

# 3. GitHub OAuth App (Required for User Login and Repository Access)
# Create at: https://github.com/settings/developers
# - Homepage URL: http://localhost:3000
# - Authorization callback URL: http://localhost:8080/login/oauth2/code/github
GITHUB_CLIENT_ID=your_client_id_here
GITHUB_CLIENT_SECRET=your_client_secret_key_here

# 4. Security & Encryption (Token storage encryption)
TOKEN_ENCRYPTOR_PASSWORD=devpilotSecretKey123
TOKEN_ENCRYPTOR_SALT=a1b2c3d4e5f67890

# 5. URLs
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000
PORT=8080
